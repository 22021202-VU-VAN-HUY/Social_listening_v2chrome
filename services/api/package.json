{
  "name": "@listening-socialmediav2/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "npm --prefix ../../packages/contracts run build",
    "dev": "tsx watch src/index.ts",
    "prebuild": "npm --prefix ../../packages/contracts run build",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "pretypecheck": "npm --prefix ../../packages/contracts run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm --prefix ../../packages/contracts run build",
    "test": "tsx --test test/**/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@listening-social/contracts": "file:../../packages/contracts",
    "dotenv": "^17.2.1",
    "fastify": "^5.6.0",
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
