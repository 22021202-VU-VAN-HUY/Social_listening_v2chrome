# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# PostgreSQL / API
DATABASE_URL=postgres://listening:listening@localhost:5432/listening
WORKSPACE_ID=00000000-0000-4000-8000-000000000001
HOST=0.0.0.0
PORT=4000
CORS_ORIGINS=http://localhost:3000,https://listening-socialmediav2.m-ilestyler431554.chatgpt.site
DEVICE_ONLINE_SECONDS=60
LEASE_TTL_SECONDS=45
ADAPTER_VERSION=facebook-dom-v1

# Sentiment (API keys are passed only to the worker container)
# auto: OpenAI first, then Gemini, then MiMo.
SENTIMENT_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro

# Backward-compatible custom OpenAI-compatible provider settings.
SENTIMENT_MODEL=sentiment-development
SENTIMENT_BASE_URL=http://localhost:11434
SENTIMENT_API_KEY=
SENTIMENT_TOPIC=VinSmart Future
SENTIMENT_CONFIDENCE_REVIEW_THRESHOLD=0.60
ALLOW_HEURISTIC_FALLBACK=false
